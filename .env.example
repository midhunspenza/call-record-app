# --- spenza-backend API access (from api-documentation.html §Authentication) ---
SPENZA_API_BASE_URL=https://api-stage.spenza.com
SPENZA_API_KEY=spk_59a448a9ae72426972cbd6f4577da879
SPENZA_API_SECRET=sps_d8c4a071437650731695a39682160cbe3bb36e4c611219f5

# --- which operator/network this console subscribes to ---
# Example values from the doc: "SpenzaJ" / "SpenzaJ"
SPENZA_OPERATOR=SpenzaJ
SPENZA_NETWORK=SpenzaJ

# --- the publicly-reachable URL spenza-backend should POST SMS events to ---
# For local dev, expose port 3000 with `ngrok http 3000` and paste the https URL.
# The console will register {WEBHOOK_PUBLIC_URL}/api/webhooks/sms/incoming
# and  {WEBHOOK_PUBLIC_URL}/api/webhooks/sms/status on boot.
WEBHOOK_PUBLIC_URL=https://your-tunnel.ngrok.app

# --- Basic Auth credentials spenza-backend will use when POSTing to us ---
# Generated values are fine; they're shared only between this app and spenza-backend.
WEBHOOK_BASIC_USER=spenza-console
WEBHOOK_BASIC_PASS=replace-me

# --- S3 bucket holding past call recordings (powers /recordings) ---
# AWS_ACCESS_KEY_ID/SECRET are used to list objects and generate presigned GET
# URLs for playback. Keep these scoped to read-only on the recordings bucket.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RECORDINGS_BUCKET=
# Optional key prefix, e.g. "voice/" — leave blank to list the whole bucket.
RECORDINGS_PREFIX=

# --- optional ---
# PORT=3000
# HOST=0.0.0.0
